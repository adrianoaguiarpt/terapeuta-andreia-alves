# Copie para .env e preencha. Sem SMTP_* os pedidos aparecem só no terminal (modo desenvolvimento).
PORT=3000
NODE_ENV=production

# Gmail: ative a verificação em 2 passos e crie uma "Palavra-passe de aplicação"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=terapeutandreialves@gmail.com
SMTP_PASS=

# Para onde vão os pedidos (por omissão, SMTP_USER)
MAIL_TO=terapeutandreialves@gmail.com
MAIL_FROM=terapeutandreialves@gmail.com
